\begin_body

\begin_layout Standard
\begin_inset Formula $P\subset M_{\mathbb{R}}$
\end_inset

 is a 
\begin_inset Formula $n$
\end_inset

-dimensional lattice polytope with volume 
\begin_inset Formula $V_{P}$
\end_inset

.
 
\begin_inset Formula $P_{k}=P\cap k^{-1}M$
\end_inset

.
 
\begin_inset Formula $N_{k}=\left|P_{k}\right|$
\end_inset

.
 Let 
\begin_inset Formula $\sigma_{k}:P_{k}\rightarrow\mathbb{R}_{>0}$
\end_inset

 be the shortest GKZ vector.
 Let 
\begin_inset Formula 
\[
\phi_{k}\coloneqq k^{n}\sigma^{\vee}_{k},\ \psi_{k}\coloneqq2k\left(V_{P}\phi_{k}-1\right).
\]

\end_inset


\begin_inset Formula $\sigma_{k}$
\end_inset

 is convex,
 which means that the restriction 
\begin_inset Formula $\phi_{k}|_{P_{k}}=k^{n}\sigma_{k}$
\end_inset

.
 
\end_layout

\begin_layout Standard
Variational characterization of 
\begin_inset Formula $\phi_{k},\psi_{k}$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\phi_{k}=k^{n}\sigma^{\vee}_{k}$
\end_inset

 is the unique minimizer of 
\begin_inset Formula 
\[
\Phi_{k}(\eta)\coloneqq\frac{1}{2k^{n}}\sum_{u\in P_{k}}\eta(u)^{2}-\frac{1}{V_{P}}\int_{P}\eta,\ \eta\in\mathcal{C}(P).
\]

\end_inset


\begin_inset Formula 
\[
\lim_{k}\Phi_{k}(\eta)=\Phi(\eta)\coloneqq\frac{1}{2}\int_{P}\eta^{2}-\frac{1}{V_{P}}\int_{P}\eta,\ \text{minimizer is }\phi=V^{-1}_{P}.
\]

\end_inset


\begin_inset Formula $\psi_{k}\coloneqq2k\left(V_{P}\phi_{k}-1\right)$
\end_inset

 is the unique minimizer of 
\begin_inset Formula 
\[
\Psi_{k}(\eta)\coloneqq\frac{1}{2k^{n}}\sum_{u\in P_{k}}\eta(u)^{2}+\frac{2}{k^{n-1}}\left(\sum_{u\in P_{k}}\eta(u)-k^{n}\int_{P}\eta\ \mathrm{d}x\right)
\]

\end_inset


\begin_inset Formula 
\[
\lim_{k}\Psi_{k}(\eta)=\Psi(\eta)\coloneqq\frac{1}{2}\int_{P}\eta^{2}\mathrm{d}x+\int_{\partial P}\eta\ \mathrm{d}\sigma,\ \text{minimizer is }\psi=-\Theta_{P}.
\]

\end_inset


\end_layout

\begin_layout Enumerate
Variational inequalities.
 For 
\begin_inset Formula $\phi_{k}$
\end_inset

,
 we have 
\begin_inset Formula 
\[
\frac{1}{k^{n}}\sum_{u\in P_{k}}\phi_{k}(u)\eta(u)\geq\frac{1}{V_{P}}\int_{P}\eta\text{ and }\frac{1}{k^{n}}\sum_{u\in P_{k}}\phi_{k}(u)^{2}=\frac{1}{V_{P}}\int_{P}\phi_{k},
\]

\end_inset

for any 
\begin_inset Formula $\eta\in\mathcal{C}(P)$
\end_inset

.
 This is also the variational inequality of 
\begin_inset Formula $\psi_{k}$
\end_inset

.
 For 
\begin_inset Formula $\psi=-\Theta_{P}$
\end_inset

,
 we have 
\begin_inset Formula 
\[
\int_{\partial P}\eta\ \mathrm{d}\sigma\ge\int_{P}\eta\Theta_{P},\ \forall\eta\in\mathcal{C}(P)\ \textrm{and}\ \int_{\partial P}\Theta_{P}\ \mathrm{d}\sigma=\int_{P}\Theta^{2}_{P}.
\]

\end_inset


\end_layout

\begin_layout Standard
Known bounds:
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\int_{P}\phi_{k}\leq C$
\end_inset

.
 Since we can construct a uniform triangulation 
\begin_inset Formula $T_{k}$
\end_inset

 of 
\begin_inset Formula $(P,P_{k})$
\end_inset

 such that 
\begin_inset Formula $g_{T_{k}}\leq C_{P}k^{-n}$
\end_inset

,
 then we have 
\begin_inset Formula 
\[
\int_{P}\phi_{k}=k^{n}\int_{P}\sigma^{\vee}_{k}=k^{n}V_{P}\left\Vert \sigma_{k}\right\Vert ^{2}\le k^{n}V_{P}\left\Vert g_{T_{k}}\right\Vert ^{2}\le k^{n}V_{P}\max_{P_{k}}g_{T_{k}}\le C'_{P}.
\]

\end_inset


\end_layout

\begin_layout Enumerate
There exists constant 
\begin_inset Formula $C_{P}>0$
\end_inset

 such that 
\begin_inset Formula 
\[
\fint_{P}\eta\leq\frac{C_{P}}{k^{n}}\sum_{u\in P_{k}}\eta(u),\text{ for all convex }\eta:P\rightarrow\mathbb{R}_{\ge0}.
\]

\end_inset

Since 
\begin_inset Formula 
\[
\fint_{P}\eta\le\fint_{P}\left(\eta|_{P_{k}}\right)^{\vee}\le\sum_{u\in P_{k}}\eta(u)g_{T_{k}}(u)\le\frac{C_{P}}{k^{n}}\sum_{u\in P_{k}}\eta(u).
\]

\end_inset


\end_layout

\begin_layout Standard
Our final aim is the convergence 
\begin_inset Formula $\psi_{k}\rightarrow\psi=-\Theta_{P}$
\end_inset

.
 We have a plan as follows.
 
\end_layout

\begin_layout Standard
Step1.
 Show that 
\begin_inset Formula $\phi_{k}\coloneqq k^{n}\sigma^{\vee}_{k}$
\end_inset

 is uniformly bounded above.
 
\end_layout

\begin_layout Standard
Step2.
 Show that 
\begin_inset Formula $\left\{ \phi_{k}\right\} $
\end_inset

 is equicontinuous over 
\begin_inset Formula $P$
\end_inset

.
 
\end_layout

\begin_layout Standard
Step3.
 Show that 
\begin_inset Formula $\psi_{k}\coloneqq2k\left(V_{P}\phi_{k}-1\right)$
\end_inset

 is uniformly bounded,
 i.e.
 
\begin_inset Formula $\left|\psi_{k}\right|\le C$
\end_inset

.
 
\begin_inset Newline newline
\end_inset

Remark:
 similar to the proof of Theorem 5,
 by a Gamma-convergence argument,
 we can show that 
\begin_inset Formula $\phi_{k}$
\end_inset

 converges uniformly to 
\begin_inset Formula $\phi=V^{-1}_{P}$
\end_inset

,
 which is the minimizer of 
\begin_inset Formula $\Phi=\lim\Phi_{k}$
\end_inset

.
 However,
 this is not enough to imply 
\begin_inset Formula $\left|\psi_{k}\right|\le C$
\end_inset

.
 
\end_layout

\begin_layout Standard
Step4.
 Show that 
\begin_inset Formula $\left\{ \psi_{k}\right\} $
\end_inset

 is equicontinuous over 
\begin_inset Formula $P$
\end_inset

.
 
\end_layout

\begin_layout Standard
Step5.
 Show 
\begin_inset Formula $\psi_{k}\rightarrow\psi=-\Theta_{P}$
\end_inset

,
 which has been done by Theorem 5.
 
\end_layout

\begin_layout Subsection
submultiplicity 
\end_layout

\begin_layout Standard
note that 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula 
\[
\sigma_{k+l}\left(\frac{ku+lv}{k+l}\right)\le\frac{k}{k+l}\sigma_{k}(u)+\frac{l}{k+l}\sigma_{l}(v),\ \forall u\in P_{k},v\in P_{l}
\]

\end_inset


\end_layout

\begin_layout Subsection
Algorithms
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $H\left(x,P\right)=\min_{P}\left\langle x,\cdot\right\rangle $
\end_inset

 and 
\begin_inset Formula $F(x,P)=\mathrm{argmin}_{P}\left\langle x,\cdot\right\rangle $
\end_inset


\end_layout

\begin_layout Enumerate
generate 
\begin_inset Formula $T_{1}$
\end_inset

.
 Let 
\begin_inset Formula $T:I=\{1\}\rightarrow\{\text{triangulations}\}$
\end_inset

.
 
\begin_inset Formula $\mathcal{A}=\left\{ g_{T_{i}}\mid i\in I\right\} $
\end_inset

,
 
\begin_inset Formula $\mathcal{P}=\mathrm{conv}\mathcal{A}\subset\Sigma_{k}$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
Let 
\begin_inset Formula $x\in\Sigma_{k}$
\end_inset

 be the minimizer of 
\begin_inset Formula 
\[
\min\left\{ \left\Vert g\right\Vert \mid g\in\mathcal{P}\right\} .
\]

\end_inset

Suppose 
\begin_inset Formula $x=\sum_{i\in I}\lambda_{i}g_{T_{i}}$
\end_inset

,
 then 
\begin_inset Formula $\lambda_{i}>0$
\end_inset

 implies that 
\begin_inset Formula 
\[
\left\langle x,g_{T_{i}}\right\rangle =H\left(x,\mathcal{P}\right)=\left\Vert x\right\Vert ^{2}=\min\left\{ \left\Vert g\right\Vert ^{2}\mid g\in\mathcal{P}\right\} .
\]

\end_inset


\end_layout

\begin_layout Enumerate
Check 
\begin_inset Formula $x=\sigma_{k}$
\end_inset

?
 which happens iff 
\begin_inset Formula $\min_{\Sigma_{k}}\left\langle x,\cdot\right\rangle =\left\Vert x\right\Vert ^{2}$
\end_inset

.
 note that we always have 
\begin_inset Formula $\min_{\Sigma_{k}}\left\langle x,\cdot\right\rangle \le\min_{\mathcal{P}}\left\langle x,\cdot\right\rangle =\left\Vert x\right\Vert ^{2}$
\end_inset

.
 
\begin_inset Newline newline
\end_inset

If the threshold 
\begin_inset Formula $\delta(x)=\left\Vert x\right\Vert ^{2}-\min_{\Sigma_{k}}\left\langle x,\cdot\right\rangle <\varepsilon$
\end_inset

.
 Output 
\begin_inset Formula $x$
\end_inset

.
 
\begin_inset Newline newline
\end_inset

Otherwise,
 by 
\begin_inset Formula $\mathrm{argmin}_{\Sigma_{k}}\left\langle x,\cdot\right\rangle =F\left(S(x)\right)$
\end_inset

,
 for any 
\begin_inset Formula $T_{j}\prec S(x)$
\end_inset

,
 we have 
\begin_inset Formula $\left\langle x,g_{T_{j}}\right\rangle =\min_{\Sigma_{k}}\left\langle x,\cdot\right\rangle $
\end_inset

.
 
\begin_inset Newline newline
\end_inset

Add finitely many 
\begin_inset Formula $T_{j}$
\end_inset

 into 
\begin_inset Formula $\mathcal{A}$
\end_inset

.
 Back to 2.
 
\end_layout

