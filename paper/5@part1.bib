@misc{finski_about_2024,
	title = {About Wess-Zumino-Witten equation and Harder-Narasimhan potentials},
	url = {http://arxiv.org/abs/2407.06034},
	doi = {10.48550/arXiv.2407.06034},
	abstract = {For a polarized family of complex projective manifolds, we identify the algebraic obstructions that govern the existence of approximate solutions to the Wess-Zumino-Witten equation. When this is specialized to the fibration associated with a projectivization of a vector bundle, we recover a version of Kobayashi-Hitchin correspondence. More broadly, we demonstrate that a certain auxiliary Monge-Amp{\textbackslash}`ere type equation, generalizing the Wess-Zumino-Witten equation by taking into account the weighted Bergman kernel associated with the Harder-Narasimhan filtrations of direct image sheaves, admits approximate solutions over any polarized family. These approximate solutions are shown to be the closest counterparts to true solutions of the Wess-Zumino-Witten equation whenever the latter do not exist, as they minimize the associated Yang-Mills functional. As an application, in a fibered setting, we prove an asymptotic converse to the Andreotti-Grauert theorem conjectured by Demailly.},
	number = {{arXiv}:2407.06034},
	publisher = {{arXiv}},
	author = {Finski, Siarhei},
	urldate = {2025-09-24},
	date = {2024},
	eprinttype = {arxiv},
	eprint = {2407.06034},
	file = {Full Text PDF:/Users/mac/Zotero/storage/A2GTDDES/Finski - 2024 - About Wess-Zumino-Witten equation and Harder-Narasimhan potentials.pdf:application/pdf},
}

