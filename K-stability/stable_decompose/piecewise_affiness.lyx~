\begin_layout Section
Setup
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $P\subset\mathbb{R}^{n}$
\end_inset

 be a 
\begin_inset Formula $n$
\end_inset

-dimensional lattice polytope with volume 
\begin_inset Formula $V_{P}$
\end_inset

.
 Let 
\begin_inset Formula $\mathrm{d}\sigma$
\end_inset

 be the lattice boundary measure on 
\begin_inset Formula $\partial P$
\end_inset

,
 which is defined as follows.
 For each facet 
\begin_inset Formula $F\subset\partial P$
\end_inset

 spanning affine subspace 
\begin_inset Formula $\mathrm{Aff}(F)$
\end_inset

,
 
\begin_inset Formula $\mathrm{d}\sigma|_{F}$
\end_inset

 is the Lebesgue measure normalized by the lattice 
\begin_inset Formula $\mathrm{Aff}(F)\cap\mathbb{Z}^{n}$
\end_inset

.
 If 
\begin_inset Formula 
\[
F=\left\{ x\in\mathbb{R}^{n}\mid\left\langle x,v_{F}\right\rangle +a_{F}\ge0\right\} ,
\]

\end_inset

where 
\begin_inset Formula $v_{F}\in\mathbb{Z}^{n}$
\end_inset

 is primitive.
 Then 
\begin_inset Formula $\mathrm{d}\sigma|_{F}=\mathrm{d}s/\left|v_{F}\right|$
\end_inset

,
 
\begin_inset Formula $\mathrm{d}s$
\end_inset

 is the Euclidean boundary measure.
 
\end_layout

\begin_layout Section
Question 
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\mathcal{C}(P)$
\end_inset

 be the space of convex functions on 
\begin_inset Formula $P$
\end_inset

 (continuous up to 
\begin_inset Formula $\partial P$
\end_inset

).
 Consider a functional 
\begin_inset Formula 
\[
\Psi(f)=\frac{1}{2}\int_{P}f^{2}\mathrm{d}x+\int_{\partial P}f\ \mathrm{d}\sigma,\ f\in\mathcal{C}(P).
\]

\end_inset

Known facts:
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Psi$
\end_inset

 admits a unique minimizer 
\begin_inset Formula $\psi=-\Theta_{P}\in\mathcal{C}(P)$
\end_inset

,
 which is continuous up to 
\begin_inset Formula $\partial P$
\end_inset

.
 Refer to 
\begin_inset CommandInset citation
LatexCommand cite
key "Szekelyhidi"
literal "false"

\end_inset

 and 
\begin_inset CommandInset citation
LatexCommand cite
key "Sheng-Yao"
literal "false"

\end_inset

.
 We call 
\begin_inset Formula $\Theta_{P}$
\end_inset

 the optimal test-function,
 which equals to 
\begin_inset Formula $B$
\end_inset

 in 
\begin_inset CommandInset citation
LatexCommand cite
key "Szekelyhidi"
literal "false"

\end_inset

.
 
\end_layout

\begin_layout Enumerate
variational inequality:
 
\begin_inset Formula $\int_{\partial P}f\mathrm{d}\sigma\ge\int_{P}f\Theta_{P},\ \text{for }\forall f\in\mathcal{C}(P)$
\end_inset

.
 
\begin_inset Formula $\int_{\partial P}\Theta_{P}\mathrm{d}\sigma=\int_{P}\Theta^{2}_{P}$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Theta_{P}$
\end_inset

 is the unique element with minimal 
\begin_inset Formula $L^{2}$
\end_inset

-norm in the set 
\begin_inset Formula 
\[
\mathcal{S}(P)=\left\{ \theta\in L^{2}(P)\mid\int_{\partial P}f\mathrm{d}\sigma\ge\int_{P}f\theta,\ \forall f\in\mathcal{C}(P)\right\} .
\]

\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\sup_{P}\Theta_{P}=\sup_{\partial P}\Theta_{P}>0$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
\begin_inset CommandInset citation
LatexCommand cite
key "Li-Zhou"
literal "false"

\end_inset

 
\begin_inset Formula $\psi=-\Theta_{P}$
\end_inset

 satisfies the homogenous Monge–Ampère equation in the sense of Alexandrov.
 Precisely,
 for any compact set 
\begin_inset Formula $K\subset\mathrm{int}P$
\end_inset

,
 the Lebesgue measure 
\begin_inset Formula $\left|\partial u(K)\right|=0$
\end_inset

.
 
\end_layout

\begin_layout Standard
Question:
 Is 
\begin_inset Formula $\Theta_{P}$
\end_inset

 piecewisely affine or not ?
\end_layout

