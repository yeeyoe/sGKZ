\begin_layout Title
遗留的问题
\end_layout

\begin_layout Section
Setup
\end_layout

\begin_layout Standard
\begin_inset Formula $P\subset\mathbb{R}^{n}$
\end_inset

 is a 
\begin_inset Formula $n$
\end_inset

-dimensional lattice polytope with volume 
\begin_inset Formula $V_{P}$
\end_inset

.
 
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\mathrm{d}\sg$
\end_inset

 be the lattice boundary measure on 
\begin_inset Formula $\partial P$
\end_inset

,
 defined as follows:
 for each facet 
\begin_inset Formula $F\subset\partial P$
\end_inset

 spanning affine subspace 
\begin_inset Formula $\mathrm{Aff}(F)$
\end_inset

,
 
\begin_inset Formula $\mathrm{d}\sigma|_{F}$
\end_inset

 is the Lebesgue measure normalized by the lattice 
\begin_inset Formula $\mathrm{Aff}(F)\cap\mathbb{Z}^{n}$
\end_inset

.
 
\end_layout

\begin_layout Section
Is 
\begin_inset Formula $\Theta_{P}$
\end_inset

 piecewisely affine ?
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\mathcal{C}(P)$
\end_inset

 be the space of convex functions on 
\begin_inset Formula $P$
\end_inset

 (continuous up to 
\begin_inset Formula $\partial P$
\end_inset

).
 Consider a functional 
\begin_inset Formula 
\[
\Psi\left(f\right)\deff\frac{1}{2}\int_{P}f^{2}\mathrm{d}x+\int_{\partial P}f\ \mathrm{d}\sg,\ f\in\mathcal{C}(P).
\]

\end_inset

We can show that it admits a unique minimizer 
\begin_inset Formula $\psi=-\Theta_{P}\in\mathcal{C}(P)$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\psi$
\end_inset

 is continuous up to 
\begin_inset Formula $\partial P$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
variational inequality 
\begin_inset Formula $\int_{\partial P}f\mathrm{d}\sg\ge\int_{P}f\Theta_{P},\ \forall f\in\mathcal{C}(P)$
\end_inset

.
 
\begin_inset Formula $\int_{\partial P}\Theta_{P}\mathrm{d}\sg=\int_{P}\Theta^{2}_{P}$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Theta_{P}$
\end_inset

 is the unique minimal-norm element in the set 
\begin_inset Formula 
\[
\mathcal{S}(P)=\left\{ \theta\in L^{2}(P)\ \Big|\int_{\partial P}f\ge\int_{P}f\theta,\ \forall f\in\mathcal{C}(P)\right\} .
\]

\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\sup_{P}\Theta_{P}=\sup_{\partial P}\Theta_{P}>0$
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $\psi=-\Theta_{P}$
\end_inset

 satisfies the homogenous Monge–Ampère equation in the sense of Alexandrov.
 Precisely,
 for any compact set 
\begin_inset Formula $K\subset\mathrm{int}P$
\end_inset

,
 the Lebesgue measure 
\begin_inset Formula $\left|\partial u(K)\right|=0$
\end_inset

.
 
\end_layout

\begin_layout Standard
Question:
 Is 
\begin_inset Formula $\Theta_{P}$
\end_inset

 piecewisely affine or not ?
\end_layout

\begin_layout Section
minimizers convergence problem
\end_layout

\begin_layout Standard
For 
\begin_inset Formula $k\geq1$
\end_inset

,
 set 
\begin_inset Formula $P_{k}=P\cap k^{-1}\mathbb{Z}^{n}$
\end_inset

.
 
\begin_inset Formula $N_{k}=\left|P_{k}\right|$
\end_inset

.
 Let 
\begin_inset Formula $\sigma_{k}:P_{k}\rightarrow\mathbb{R}_{>0}$
\end_inset

 be the shortest GKZ vector associated to set 
\begin_inset Formula $P_{k}$
\end_inset

.
 Let 
\begin_inset Formula 
\[
\phi_{k}\coloneqq k^{n}\sigma^{\vee}_{k},\ \psi_{k}\coloneqq2k\left(V_{P}\phi_{k}-1\right),
\]

\end_inset

where 
\begin_inset Formula $\sigma^{\vee}_{k}:P\ra\mathbb{R}$
\end_inset

 is the convex envelope of 
\begin_inset Formula $\sigma_{k}$
\end_inset

.
 We know 
\begin_inset Formula $\sigma_{k}$
\end_inset

 is convex,
 which means that the restriction 
\begin_inset Formula $\phi_{k}|_{P_{k}}=k^{n}\sigma_{k}$
\end_inset

.
 
\end_layout

\begin_layout Standard
Variational characterization of 
\begin_inset Formula $\phi_{k},\psi_{k}$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\phi_{k}=k^{n}\sigma^{\vee}_{k}$
\end_inset

 is the unique minimizer of 
\begin_inset Formula 
\[
\Phi_{k}(\eta)\coloneqq\frac{1}{2k^{n}}\sum_{u\in P_{k}}\eta(u)^{2}-\frac{1}{V_{P}}\int_{P}\eta,\ \eta\in\mathcal{C}(P).
\]

\end_inset


\begin_inset Formula 
\[
\lim_{k}\Phi_{k}(\eta)=\Phi(\eta)\coloneqq\frac{1}{2}\int_{P}\eta^{2}-\frac{1}{V_{P}}\int_{P}\eta,\ \text{minimizer is }\phi=V^{-1}_{P}.
\]

\end_inset


\begin_inset Formula $\psi_{k}\coloneqq2k\left(V_{P}\phi_{k}-1\right)$
\end_inset

 is the unique minimizer of 
\begin_inset Formula 
\[
\Psi_{k}(\eta)\coloneqq\frac{1}{2k^{n}}\sum_{u\in P_{k}}\eta(u)^{2}+\frac{2}{k^{n-1}}\left(\sum_{u\in P_{k}}\eta(u)-k^{n}\int_{P}\eta\ \mathrm{d}x\right)
\]

\end_inset


\begin_inset Formula 
\[
\lim_{k}\Psi_{k}(\eta)=\Psi(\eta)\coloneqq\frac{1}{2}\int_{P}\eta^{2}\mathrm{d}x+\int_{\partial P}\eta\ \mathrm{d}\sigma,\ \text{minimizer is }\psi=-\Theta_{P}.
\]

\end_inset


\end_layout

\begin_layout Enumerate
Variational inequalities.
 For 
\begin_inset Formula $\phi_{k}$
\end_inset

,
 we have 
\begin_inset Formula 
\[
\frac{1}{k^{n}}\sum_{u\in P_{k}}\phi_{k}(u)\eta(u)\geq\frac{1}{V_{P}}\int_{P}\eta\text{ and }\frac{1}{k^{n}}\sum_{u\in P_{k}}\phi_{k}(u)^{2}=\frac{1}{V_{P}}\int_{P}\phi_{k},
\]

\end_inset

for any 
\begin_inset Formula $\eta\in\mathcal{C}(P)$
\end_inset

.
 This is also the variational inequality of 
\begin_inset Formula $\psi_{k}$
\end_inset

.
 For 
\begin_inset Formula $\psi=-\Theta_{P}$
\end_inset

,
 we have 
\begin_inset Formula 
\[
\int_{\partial P}\eta\ \mathrm{d}\sigma\ge\int_{P}\eta\Theta_{P},\ \forall\eta\in\mathcal{C}(P)\ \textrm{and}\ \int_{\partial P}\Theta_{P}\ \mathrm{d}\sigma=\int_{P}\Theta^{2}_{P}.
\]

\end_inset


\end_layout

\begin_layout Standard
Known facts:
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\int_{P}\phi_{k}\leq C$
\end_inset

.
 Since we can construct a uniform triangulation 
\begin_inset Formula $T_{k}$
\end_inset

 of 
\begin_inset Formula $(P,P_{k})$
\end_inset

 such that 
\begin_inset Formula $g_{T_{k}}\leq C_{P}k^{-n}$
\end_inset

,
 then we have 
\begin_inset Formula 
\[
\int_{P}\phi_{k}=k^{n}\int_{P}\sigma^{\vee}_{k}=k^{n}V_{P}\left\Vert \sigma_{k}\right\Vert ^{2}\le k^{n}V_{P}\left\Vert g_{T_{k}}\right\Vert ^{2}\le k^{n}V_{P}\max_{P_{k}}g_{T_{k}}\le C'_{P}.
\]

\end_inset


\end_layout

\begin_layout Enumerate
There exists constant 
\begin_inset Formula $C_{P}>0$
\end_inset

 such that 
\begin_inset Formula 
\[
\fint_{P}\eta\leq\frac{C_{P}}{k^{n}}\sum_{u\in P_{k}}\eta(u),\text{ for all convex }\eta:P\rightarrow\mathbb{R}_{\ge0}.
\]

\end_inset

Since 
\begin_inset Formula 
\[
\fint_{P}\eta\le\fint_{P}\left(\eta|_{P_{k}}\right)^{\vee}\le\sum_{u\in P_{k}}\eta(u)g_{T_{k}}(u)\le\frac{C_{P}}{k^{n}}\sum_{u\in P_{k}}\eta(u).
\]

\end_inset


\end_layout

\begin_layout Enumerate
There exists constants 
\begin_inset Formula $C_{P},N_{P}>0$
\end_inset

 such that for any 
\begin_inset Formula $\eta\in\mathcal{C}(P)$
\end_inset

,
 we have 
\begin_inset Formula 
\[
\left\Vert \eta\right\Vert _{L^{2}(P)}\le C_{P}\left\Vert \eta\right\Vert _{2,P_{k}},\ \text{when }k>N_{P},
\]

\end_inset

 where 
\begin_inset Formula $\left\Vert \eta\right\Vert ^{2}_{2,P_{k}}=\frac{1}{k^{n}}\sum_{u\in P_{k}}\eta(u)^{2}$
\end_inset

.
 
\end_layout

\begin_layout Enumerate
Let 
\begin_inset Formula $K\Subset K'\Subset\mathrm{int}P$
\end_inset

 be two compact subsets and 
\begin_inset Formula $d=\mathrm{dist}(K,\partial K')$
\end_inset

,
 then for any convex function 
\begin_inset Formula $\eta$
\end_inset

 on 
\begin_inset Formula $\mathrm{int}P$
\end_inset

,
 we have 
\begin_inset Formula 
\[
\mathrm{Lip}_{K}(\eta)\le10d^{-1}\sup_{K^{d/5}}\left|\eta\right|\le C_{n}d^{-n-1}\left\Vert \eta\right\Vert _{L^{1}(K')},
\]

\end_inset

where 
\begin_inset Formula $K^{d/5}\coloneqq\left\{ x\in P\mid d(x,K)\le d/5\right\} $
\end_inset

 and 
\begin_inset Formula $\mathrm{Lip}_{K}(\eta)$
\end_inset

 is the Lipschitz constant of 
\begin_inset Formula $\eta$
\end_inset

 over 
\begin_inset Formula $K$
\end_inset

.
 
\end_layout

\begin_layout Subsection
Uniform convergence 
\end_layout

\begin_layout Standard
Question:
 show 
\begin_inset Formula $\psi_{k}\rightarrow\psi=-\Theta_{P}$
\end_inset

 uniformly.
 
\end_layout

\begin_layout Standard
We have a plan as follows.
 
\end_layout

\begin_layout Standard
Step1.
 Show that 
\begin_inset Formula $\phi_{k}\coloneqq k^{n}\sigma^{\vee}_{k}$
\end_inset

 is uniformly bounded above.
 
\end_layout

\begin_layout Standard
Step2.
 Show that 
\begin_inset Formula $\left\{ \phi_{k}\right\} $
\end_inset

 is equicontinuous over 
\begin_inset Formula $P$
\end_inset

.
 
\end_layout

\begin_layout Standard
Step3.
 Show that 
\begin_inset Formula $\psi_{k}\coloneqq2k\left(V_{P}\phi_{k}-1\right)$
\end_inset

 is uniformly bounded,
 i.e.
 
\begin_inset Formula $\left|\psi_{k}\right|\le C$
\end_inset

.
 
\begin_inset Newline newline
\end_inset

Remark:
 similar to the proof of Theorem 5,
 by a Gamma-convergence argument,
 we can show that 
\begin_inset Formula $\phi_{k}$
\end_inset

 converges uniformly to 
\begin_inset Formula $\phi=V^{-1}_{P}$
\end_inset

,
 which is the minimizer of 
\begin_inset Formula $\Phi=\lim\Phi_{k}$
\end_inset

.
 However,
 this is not enough to imply 
\begin_inset Formula $\left|\psi_{k}\right|\le C$
\end_inset

.
 
\end_layout

\begin_layout Standard
Step4.
 Show that 
\begin_inset Formula $\left\{ \psi_{k}\right\} $
\end_inset

 is equicontinuous over 
\begin_inset Formula $P$
\end_inset

.
 
\end_layout

\begin_layout Standard
Step5.
 Show 
\begin_inset Formula $\psi_{k}\rightarrow\psi=-\Theta_{P}$
\end_inset

,
 which has been done in Theorem 5 of Sheng-Yao's paper.
 
\end_layout

\begin_layout Subsection
\begin_inset Formula $L^{2}$
\end_inset

 convergence
\end_layout

